generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  email         String    @unique
  idNumber      String    @unique
  phone         String
  passwordHash  String
  role          String    @default("user")
  createdAt     DateTime  @default(now())

  accounts Account[]
  payments Payment[]
  loans    Loan[]
  otp      Otp?
  withdrawals Withdrawal[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // "Account 1" or "Account 2"
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  payments Payment[]
}

model Otp {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  breakdown    String
  totalAmount  Float
  
  method       String
  payerName    String
  paidOn       DateTime
  status       String   @default("pending")
  rejectReason String?
  createdBy    String   @default("user")
  createdAt    DateTime @default(now())
}

model Loan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String   // Loan is tied to an account
  
  type        String
  principal   Float
  amountToPay Float
  paidAmount  Float    @default(0)
  
  // NEW INSTALLMENT FIELDS
  periodMonths Int     @default(1)
  monthlyInstallment Float
  
  issuedOn    DateTime
  dueDate     DateTime
  status      String   @default("unpaid")
  createdAt   DateTime @default(now())
}

model Setting {
  id          Int    @id @default(1)
  paybill     String @default("")
  accountNo   String @default("")
  sendMoneyTo String @default("")
  adminName   String @default("")
}
model Withdrawal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account1Amt   Float    @default(0)
  account2Amt   Float    @default(0)
  totalAmount   Float
  method        String
  methodDetails String
  paidOn        DateTime
  approvedAt    DateTime? // NEW: Records exact approval time
  status        String   @default("pending")
  createdAt     DateTime @default(now()) // Records exact request time
}