generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  email         String    @unique
  idNumber      String    @unique
  phone         String
  passwordHash  String
  role          String    @default("user")
  savingsTotal  Float     @default(0)
  emergencyDebt Float     @default(0)
  normalDebt    Float     @default(0)
  createdAt     DateTime  @default(now())

  payments Payment[]
  loans    Loan[]
  otp      Otp?
}

model Otp {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  breakdown    String
  totalAmount  Float
  
  method       String
  payerName    String
  paidOn       DateTime
  status       String   @default("pending")
  rejectReason String?
  createdBy    String   @default("user")
  createdAt    DateTime @default(now())
}

model Loan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  principal   Float
  amountToPay Float
  paidAmount  Float    @default(0)
  issuedOn    DateTime
  dueDate     DateTime
  status      String   @default("unpaid")
  createdAt   DateTime @default(now())
}

model Setting {
  id          Int    @id @default(1)
  paybill     String @default("")
  accountNo   String @default("")
  sendMoneyTo String @default("")
  adminName   String @default("")
}